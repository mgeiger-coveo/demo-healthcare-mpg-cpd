# Frontend Environment Variables (VITE_ prefix for client-side access)
VITE_PLATFORM_URL=https://platform.cloud.coveo.com
VITE_ORGANIZATION_ID=your-organization-id
VITE_USER_EMAIL=user@example.com
VITE_COMMERCE_ENGINE_URL=https://your-commerce-url.com
VITE_COMMERCE_ENGINE_TRACKING_ID=your-tracking-id
VITE_COMMERCE_ENGINE_CURRENCY=USD
VITE_COMMERCE_ENGINE_LANGUAGE=en
VITE_COMMERCE_ENGINE_COUNTRY=US
VITE_COMMERCE_RECS_SLOTID=your-recs-slot-id
VITE_GET_PRODUCT_LISTING_API_KEY=your-product-listing-api-key
GENERATE_SOURCEMAP=false
PORT=3000

# Authentication: choose ONE of the two options below.
#
# Option 1 (default) - Authentication API Key (server-side token generation):
#   Set API_KEY to an API key with the "Authenticated Search" preset.
#   The server (api-server.js / Netlify function) uses this key to generate
#   short-lived search tokens on behalf of users. This is the recommended
#   approach for production deployments.
#
# Option 2 - Search API Key (client-side, no token server needed):
#   Set VITE_SEARCH_API_KEY to a Search API key. When defined, the app uses
#   this key directly as the access token for all engines and the Commerce
#   Agent, bypassing the server-side token generation entirely.
#   This is simpler to set up but the key is exposed to the browser.
#
# If VITE_SEARCH_API_KEY is set, it takes priority over API_KEY.

# Option 2: uncomment and set to use a Search API key directly
# VITE_SEARCH_API_KEY=your-search-api-key

# Option 1: server-side variables for token generation (Netlify Functions / local API server)
PLATFORM_URL=https://platform.cloud.coveo.com
ORGANIZATION_ID=your-organization-id
API_KEY=your-api-key-with-impersonate-privilege
USER_EMAIL=user@example.com

# Password protection (optional, for Netlify)
# NETLIFY_PASSWORD_PROTECTED=true
# PASSWORD=your-password

# Agent Configuration (optional, for Commerce Agent feature)
VITE_AGENT_NAME="Your agent name and persona description"
VITE_AGENT_PURPOSE="Your agent's purpose description"

AWS_REGION=us-east-1
AWS_BEDROCK_AGENTCORE_QUALIFIER=DEFAULT
AWS_ROLE_ARN=arn:aws:iam::your-account-id:role/YourRole
AWS_BEDROCK_AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:your-account-id:runtime/your-runtime

# AWS credentials - put these in .env.local (NOT here, to keep them out of git)
# HC_AWS_ACCESS_KEY_ID=AKIA...
# HC_AWS_SECRET_ACCESS_KEY=lho...

# Optional: Firebase email/password gate.
# Only needed when EnableAuthentication is true in src/config/HomeConfig.tsx.
# VITE_FIREBASE_API_KEY=your-firebase-web-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_AUTH_ADMIN_EMAIL=admin@example.com
